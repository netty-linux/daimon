{
  "name": "daimon-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:approval": "node scripts/approval-smoke.mjs",
    "smoke:computer": "node scripts/computer-smoke.mjs",
    "smoke:computer-view": "node scripts/computer-view-smoke.mjs",
    "smoke:mcp": "node scripts/approval-smoke.mjs --mcp",
    "smoke:memory": "node scripts/memory-smoke.mjs",
    "smoke:cloud": "node scripts/sandbox-smoke.mjs --cloud",
    "smoke:sandbox": "node scripts/sandbox-smoke.mjs",
    "smoke:environments": "node scripts/environments-smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
