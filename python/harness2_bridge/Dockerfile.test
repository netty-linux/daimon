# Optional offline test runner; build has network only to fetch pinned tooling.
FROM golang:1.27.1 AS go
FROM ghcr.io/astral-sh/uv:0.12.17 AS uv
FROM python:3.12.10-bookworm
COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /usr/local/bin/uv
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /opt/bridge
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --python /usr/local/bin/python3.12 --no-managed-python
WORKDIR /work
CMD ["bash", "/source/python/harness2_bridge/test-linux.sh"]
